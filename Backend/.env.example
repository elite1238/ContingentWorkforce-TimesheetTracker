# Environment Variables Template
# Copy this to .env and fill in actual values for local development
# NEVER commit .env file to git
# NEVER commit actual secrets — only commit .env.example

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================
DB_URL=jdbc:postgresql://localhost:5432/workforce_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ============================================================================
# JWT CONFIGURATION (REQUIRED)
# ============================================================================
# Generate 64-char hex string with: openssl rand -hex 32
# Minimum 32 characters (256 bits) for HS512
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ============================================================================
# EMAIL SERVICE - RESEND (REQUIRED)
# ============================================================================
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_actual_key_here
RESEND_FROM_EMAIL=vendor@projectbuild.me

# ============================================================================
# SSL/HTTPS CONFIGURATION (PRODUCTION ONLY)
# ============================================================================
# Paths to SSL keystore for HTTPS
# Generate: keytool -genkeypair -alias tomcat -keyalg RSA -keysize 2048 -storetype PKCS12 -keystore keystore.p12 -validity 365
# SSL_KEYSTORE_PATH=/path/to/keystore.p12
# SSL_KEYSTORE_PASSWORD=your_keystore_password

# ============================================================================
# CORS CONFIGURATION (REQUIRED)
# ============================================================================
# Comma-separated list of allowed origins (never use wildcard in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ============================================================================
# SPRING CONFIGURATION
# ============================================================================
# Profile: dev, prod, test
SPRING_PROFILES_ACTIVE=dev

# ============================================================================
# LOGGING CONFIGURATION (OPTIONAL)
# ============================================================================
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_BACKEND_WF=DEBUG
