# Environment Variables Template
# Copy this to .env and fill in actual values for local development
# NEVER commit .env file to git

# Resend Email Service
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_actual_key_here
RESEND_FROM=vendor@projectbuild.me

# Database (if using env variables instead of application.yml)
# DB_URL=jdbc:postgresql://localhost:5432/workforce_db
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# JWT Secret (if using env variable)
# JWT_SECRET=your_secret_here
# JWT_EXPIRATION_MS=86400000

# Application Port
# SERVER_PORT=8080
